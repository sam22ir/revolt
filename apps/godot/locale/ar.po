msgid "story.algeria.ch3.scene2"
msgstr "[مسودة، تحتاج مراجعة مؤرخ] بعد العودة، تراجع المجموعة ما سار على ما يرام وما يجب تحسينه."

msgid "story.vietnam.ch1.title"
msgstr "[مسودة] الاستعدادات"

