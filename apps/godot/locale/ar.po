msgid "story.algeria.ch1.title"
msgstr "[مسودة] الاستعدادات"

msgid "story.algeria.ch1.scene1"
msgstr "[مسودة، تحتاج مراجعة مؤرخ] يجتمع أهل المكان بعد الغروب. المهمة الأولى واضحة: يجب أن يكبر مركز القيادة حتى تُوضع الخطط وتبقى منظمة."

msgid "story.algeria.ch1.scene2"
msgstr "[مسودة، تحتاج مراجعة مؤرخ] يبدأ العمل مع الفجر. لكل واحد دور يؤديه، مهما كان صغيرًا."

