msgid "story.vietnam.ch2.scene2"
msgstr "[مسودة، تحتاج مراجعة مؤرخ] مجموعة صغيرة أولى جاهزة للتنظيم. ستحتاج إلى تدريب ومن يقودها."

msgid "story.vietnam.ch3.title"
