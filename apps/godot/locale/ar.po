msgstr "[مسودة] معين موثوق"

msgid "story.algeria.ch2.scene1"
msgstr "[مسودة، تحتاج مراجعة مؤرخ] يشيع الخبر أن شخصًا موثوقًا مستعد للمساعدة. صاحب المهارات المناسبة قد يوجّه جهود الجماعة."

msgid "story.algeria.ch2.scene2"
msgstr "[مسودة، تحتاج مراجعة مؤرخ] مجموعة صغيرة أولى جاهزة للتنظيم. ستحتاج إلى تدريب ومن يقودها."

msgid "story.algeria.ch3.title"
msgstr "[مسودة] الخروج الأول"

msgid "story.algeria.ch3.scene1"
