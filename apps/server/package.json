{
  "name": "@revolt/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:mock": "wrangler dev --config wrangler.e2e.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "e2e:serve": "rm -rf .wrangler/e2e && wrangler d1 migrations apply DB --local --config wrangler.e2e.jsonc --persist-to .wrangler/e2e && wrangler dev --config wrangler.e2e.jsonc --port 8788 --persist-to .wrangler/e2e"
  },
  "dependencies": {
    "@revolt/rules": "workspace:*",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261013.1",
    "@types/node": "^24.19.2",
    "miniflare": "5.20261012.1-beta",
    "wrangler": "4.151.1"
  }
}
