{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revolt-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Daily cleanup (src/cleanup.ts). Locally: `wrangler dev --test-scheduled`, then GET /cdn-cgi/local/scheduled.
  "triggers": { "crons": ["0 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "revolt",
      // Placeholder: replaced with the real id when the user creates the D1 database. Local dev ignores it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // The Google *web* client ID(s), comma-separated. Empty disables Google sign-in. See docs/google-oauth-setup.md.
    "GOOGLE_CLIENT_IDS": "",
    // Vite dev and preview, and the Capacitor Android/iOS WebView origins.
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173,https://localhost,capacitor://localhost",
    // Guest accounts per client IP (IPv6: /64) per hour. Mobile carriers share IPs (CGNAT), so keep it generous.
    "GUEST_LIMIT_PER_HOUR": "30"
  }
}
