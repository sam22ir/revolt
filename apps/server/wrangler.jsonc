{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revolt-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Daily cleanup (src/cleanup.ts). Locally: `wrangler dev --test-scheduled`, then GET /cdn-cgi/local/scheduled.
  "triggers": { "crons": ["0 3 * * *"] },
  // One WorldMap Durable Object per server map (src/map/world-map.ts). SQLite storage: the only kind on the Free plan.
  // One AllianceRoom per alliance (src/alliance/alliance-room.ts): its chat.
  "durable_objects": {
    "bindings": [
      { "name": "WORLD_MAP", "class_name": "WorldMap" },
      { "name": "ALLIANCE_ROOM", "class_name": "AllianceRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorldMap"] },
    { "tag": "v2", "new_sqlite_classes": ["AllianceRoom"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "revolt-db",
      // The deployed database (docs/deploy.md). Local dev ignores the id.
      "database_id": "ebea5819-75c3-4a43-931d-a828830fea82",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // The Google *web* client ID(s), comma-separated. Empty disables Google sign-in. See docs/google-oauth-setup.md.
    "GOOGLE_CLIENT_IDS": "",
    // Vite dev and preview, and the Capacitor Android/iOS WebView origins.
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173,https://localhost,capacitor://localhost,https://revolt-server.nafaa-store.workers.dev",
    // Guest accounts per client IP (IPv6: /64) per hour. Mobile carriers share IPs (CGNAT), so keep it generous.
    "GUEST_LIMIT_PER_HOUR": "30"
    // Secrets, never values in this file (docs/release.md, "Billing"). Set each with `wrangler secret put <NAME>`:
    //   REVENUECAT_SECRET  RevenueCat server-side key for checking purchase receipts. Unset: the store is browse-only
    //                      and POST /v1/store/redeem answers 503 billing_not_configured.
  }
}
