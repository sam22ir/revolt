// Local end-to-end tests only: settable clock and a fake Google issuer. Never deploy this config.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revolt-server-e2e",
  "main": "src/e2e-entry.ts",
  "compatibility_date": "2026-10-01",
  // One WorldMap Durable Object per server map (src/map/world-map.ts). SQLite storage: the only kind on the Free plan.
  "durable_objects": { "bindings": [{ "name": "WORLD_MAP", "class_name": "WorldMap" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorldMap"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "revolt-e2e",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_IDS": "mock-client-id",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173,http://localhost:4174",
    // The e2e suite makes every guest from one IP with a pinned clock.
    "GUEST_LIMIT_PER_HOUR": "100000"
  }
}
