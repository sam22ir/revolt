{
  "name": "revolt",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "dev": "pnpm --filter @revolt/client dev",
    "build": "pnpm --filter @revolt/client build",
    "preview:lan": "pnpm --filter @revolt/client build && pnpm --filter @revolt/client preview",
    "art:process": "node scripts/process-art.mjs",
    "art:terrain": "node scripts/process-terrain.mjs",
    "godot:export": "node scripts/export-godot.mjs",
    "godot:test": "cd apps/godot && godot --headless -s addons/gut/gut_cmdln.gd"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
