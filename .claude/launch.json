{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server-mock",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@revolt/server",
        "dev:mock"
      ],
      "port": 8787
